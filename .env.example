# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_min_8_chars

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=your_mongo_password

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Connection URIs
NEO4J_URI=bolt://localhost:7687
MONGO_URI=mongodb://<MONGO_USER>:<MONGO_PASSWORD>@localhost:27017/

# Entrez (NCBI PubMed)
ENTREZ_EMAIL=you@example.com
ENTREZ_API_KEY=

# MongoDB Database
MONGO_DB_NAME=llm_knowledge_discovery
